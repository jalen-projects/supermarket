# MAQAM FOOD CITY SUPERMARKET - the online shop system at maqam.campusnect.com.
#
# Its own Linux user, its own folder, its own database and its own process,
# next to CampusNect on the same server but sharing nothing with it. If this
# service stops, CampusNect does not notice; if CampusNect is restarted, the
# shop does not notice.
#
# Installed by DEPLOY-ONLINE.md:  cp deploy/maqam.service /etc/systemd/system/
[Unit]
Description=MAQAM Food City shop system (waitress)
After=network.target

[Service]
User=maqam
Group=maqam
WorkingDirectory=/home/maqam/app/supermarket_system
Environment=SMMS_ENV_FILE=/home/maqam/maqam.env
# Listens on the server itself only; nginx is the only way in from outside.
ExecStart=/home/maqam/venv/bin/waitress-serve --listen=127.0.0.1:8077 --threads=16 --url-scheme=https smms.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
