# The online shop system's private settings. Copied to /home/maqam/maqam.env
# on the server by DEPLOY-ONLINE.md and filled in THERE - never commit the real
# file: this repository is public.

# Switches on the internet-facing hardening (secure cookies, one hostname).
SMMS_ONLINE=1
SMMS_HOSTNAME=maqam.campusnect.com
SMMS_DEBUG=0

# Only used to create the owner's login BEFORE his shop data arrives. Once his
# data is imported he signs in with the password he already uses at the shop.
MAQAM_OWNER_PASSWORD=type-a-temporary-password-here

# Where "the tills went silent" and the nightly summary are sent. His email,
# and yours if you want copies, separated by a comma.
MAQAM_ALERT_EMAIL=owner@example.com

# The last day of the hosting year he has paid for (YYYY-MM-DD). He sees a
# reminder in the final 30 days. Change it when he renews, then re-run
# setup_maqam.
MAQAM_HOSTING_PAID_UNTIL=2027-10-01

# DEPLOY-ONLINE.md appends below this line: SMMS_SECRET_KEY (generated on the
# server) and the EMAIL_* lines copied from CampusNect's own settings.
