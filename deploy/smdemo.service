# FRESHWAY SUPERMARKET (DEMONSTRATION) - supermarket.campusnect.com.
#
# Its own Linux user, its own folder, its own database and its own process,
# next to CampusNect on the same server but sharing nothing with it. If this
# service stops, CampusNect does not notice; if CampusNect is restarted, the
# shop does not notice.
#
# Installed by DEPLOY-DEMO.md:  cp deploy/smdemo.service /etc/systemd/system/
[Unit]
Description=FreshWay demonstration shop system (waitress)
After=network.target

[Service]
User=smdemo
Group=smdemo
WorkingDirectory=/home/smdemo/app/supermarket_system
Environment=SMMS_ENV_FILE=/home/smdemo/smdemo.env
# Listens on the server itself only; nginx is the only way in from outside.
ExecStart=/home/smdemo/venv/bin/waitress-serve --listen=127.0.0.1:8078 --threads=16 --url-scheme=https smms.wsgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
