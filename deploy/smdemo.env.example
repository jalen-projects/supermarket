# The demonstration shop's private settings (FreshWay Supermarket, Nakawa,
# at supermarket.campusnect.com). Copied to /home/smdemo/smdemo.env on the
# server by DEPLOY-DEMO.md and filled in THERE - never commit the real file:
# this repository is public.

# Internet-facing hardening (secure cookies, one hostname).
SMMS_ONLINE=1
SMMS_HOSTNAME=supermarket.campusnect.com
SMMS_DEBUG=0

# Which shop this copy is: FreshWay's name is in the database, its mark,
# icons and browser storage names come from shop/brand.py by this word.
SMMS_BRAND=freshway

# A demonstration shop: shows the "Demo" marker, lets seed_demo_shop run,
# and can NEVER send a text message, whatever else is in this file.
SMMS_DEMO=1

# The password for every demo login (owner, manager, grace, brian, faith).
# The one in the Logins and Test Guide PDF. seed_demo_shop puts every login
# back to it each time it runs.
DEMO_PASSWORD=type-the-demo-password-here

# Deliberately NOT here: SMS credentials, email settings, alert addresses,
# Flutterwave keys, a hosting date. A demo has nobody to text or email.

# DEPLOY-DEMO.md appends below this line: SMMS_SECRET_KEY (generated on the
# server).
